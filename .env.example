# Copy to .env (`make env` generates random secrets automatically).

# --- LLM gateway (OpenAI-compatible) ---
BASE_URL=https://your-gateway.example.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=90s

# --- Voice (ElevenLabs): Scribe speech-to-text, Eleven v3 text-to-speech (speaks Uzbek) ---
# Without a key /voice/* answers 503 voice_unavailable and the UI falls back to typing.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_UZ=
# ELEVENLABS_VOICE_RU=
# ELEVENLABS_TTS_MODEL=eleven_v3
# ELEVENLABS_STT_MODEL=scribe_v2
# ElevenLabs refuses some countries (Russia included). If the server is in one, route via a proxy:
# ELEVENLABS_PROXY_URL=socks5://user:pass@host:1080

# --- Demo mode (APP_ENV=demo): every phone logs in with DEMO_OTP; POST /auth/demo ---
# APP_ENV=demo
DEMO_OTP=
DEMO_PHONE=+998901234567

# --- Database ---
POSTGRES_DB=finadvisor
POSTGRES_USER=finadvisor
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Security (never commit real values) ---
PEPPER=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=336h
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- HTTP ---
ALLOWED_ORIGINS=https://localhost,http://localhost:3000
DOMAIN=localhost
LETSENCRYPT_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
WEB_IMAGE=consul-web:latest

# --- Docker Hub (make publish) ---
DOCKERHUB_USER=
API_TAG=latest

# --- Deploy target (make deploy) ---
DEPLOY_HOST=
DEPLOY_DOMAIN=consul.env.uz
DEPLOY_USER=rocky
DEPLOY_PATH=/home/rocky/finadvisor
