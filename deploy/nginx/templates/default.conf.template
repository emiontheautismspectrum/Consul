# Rendered by the nginx image (envsubst): ${DOMAIN}, ${SSL_CERT}, ${SSL_KEY}.

# Rate-limit zones keyed by client IP.
limit_req_zone $binary_remote_addr zone=api_limit:10m  rate=10r/s;   # general API
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;   # brute-force protection
limit_req_zone $binary_remote_addr zone=ai_limit:10m   rate=3r/m;    # expensive LLM calls
limit_req_zone $binary_remote_addr zone=photo_limit:10m rate=10r/m;  # document recognition
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# Docker DNS: lets nginx start even when the optional frontend container is absent.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 1m;
    limit_conn conn_limit 50;
    gzip on;
    gzip_types application/json application/yaml text/css application/javascript;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID      $request_id;

    # Frontend (Next.js)
    location / {
        set $web http://web:3000;
        proxy_pass $web;
        proxy_http_version 1.1;
        # A location-level proxy_set_header drops inherited ones, so repeat them here.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        error_page 502 503 504 = @no_frontend;
    }
    location @no_frontend {
        default_type application/json;
        return 503 '{"error":{"code":"frontend_unavailable","message":"Frontend is not deployed yet. API docs: /api/v1/docs"}}';
    }

    # Backend (Go)
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://api:8080;
    }
    location /api/v1/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://api:8080;
    }
    location = /api/v1/advisor/generate {
        limit_req zone=ai_limit burst=3 nodelay;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://api:8080;
    }
    # Document photo recognition: larger uploads, vision model latency.
    location = /api/v1/photo {
        limit_req zone=photo_limit burst=5 nodelay;
        client_max_body_size 11m;
        client_body_buffer_size 1m;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_pass http://api:8080;
    }
}
