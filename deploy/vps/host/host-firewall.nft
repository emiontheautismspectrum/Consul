#!/usr/sbin/nft -f
# Host firewall + per-IP rate limiting for the VPS (loaded by host-firewall.service).
# Lives in its own table so it never touches Docker's (docker-bridges) or fail2ban's tables.

table inet host_fw
delete table inet host_fw

table inet host_fw {
    set ssh_rl4  { type ipv4_addr; flags dynamic, timeout; timeout 2m; }
    set ssh_rl6  { type ipv6_addr; flags dynamic, timeout; timeout 2m; }
    set web_rl4  { type ipv4_addr; flags dynamic, timeout; timeout 1m; }
    set web_rl6  { type ipv6_addr; flags dynamic, timeout; timeout 1m; }
    set web_cc4  { type ipv4_addr; flags dynamic; }
    set web_cc6  { type ipv6_addr; flags dynamic; }

    # Web ports are published by Docker (DNAT → forward path), so they are limited here,
    # before Docker's NAT (priority -100). Finer per-route limits live in nginx.
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;
        iifname "eth0" tcp dport { 80, 443 } ct state new add @web_rl4 { ip saddr limit rate over 100/second burst 200 packets } counter drop
        iifname "eth0" tcp dport { 80, 443 } ct state new add @web_rl6 { ip6 saddr limit rate over 100/second burst 200 packets } counter drop
        iifname "eth0" tcp dport { 80, 443 } ct state new add @web_cc4 { ip saddr ct count over 300 } counter drop
        iifname "eth0" tcp dport { 80, 443 } ct state new add @web_cc6 { ip6 saddr ct count over 300 } counter drop
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept
        iifname { "docker0", "br-*" } accept                      # containers → host
        udp sport 67 udp dport 68 accept                          # DHCP (cloud network)
        meta l4proto ipv6-icmp accept                             # IPv6 neighbor discovery
        meta l4proto icmp limit rate 10/second accept
        tcp dport 22 ct state new add @ssh_rl4 { ip saddr limit rate over 6/minute burst 6 packets } counter drop
        tcp dport 22 ct state new add @ssh_rl6 { ip6 saddr limit rate over 6/minute burst 6 packets } counter drop
        tcp dport 22 accept
        tcp dport { 80, 443 } accept
        counter
    }
}
